# LoveCards 环境变量配置示例
# 复制此文件为 .env 并填入实际值

APP_DEBUG = true

[APP]
DEFAULT_TIMEZONE = Asia/Shanghai

# ====================
# 数据库配置
# ====================
[DATABASE]
TYPE = mysql
HOSTNAME = 127.0.0.1
DATABASE = lovecards
USERNAME = root
PASSWORD =
HOSTPORT = 3306
CHARSET = utf8mb4
DEBUG = false

# ====================
# 邮箱配置
# ====================
[mail]
security = null
driver = smtp
host = smtp.example.com
port = 465
addr = noreply@example.com
pass =
name = LoveCards

# ====================
# 极验验证码配置
# 分组下的 key 不要带前缀，ThinkPHP 会自动拼接为 GROUP_KEY 格式
# ====================
[geetest]
STATUS = false
ID =
KEY =

# ====================
# 语言配置
# ====================
[LANG]
default_lang = zh-cn

# ====================
# Storage 渠道配置（可选，优先级高于数据库）
# 格式：STORAGE_{渠道}_{KEY}
# ====================

# --- COS 腾讯云 ---
# 分组下的 key 不要带前缀，ThinkPHP 会自动拼接为 GROUP_KEY 格式
# [COS]
# SECRET_ID =
# SECRET_KEY =
# BUCKET =
# REGION = ap-guangzhou
# CDN_URL =

# --- OSS 阿里云 ---
# [OSS]
# ACCESS_KEY =
# SECRET_KEY =
# BUCKET =
# ENDPOINT =
# URL_PREFIX =

# --- 七牛云 ---
# [QINIU]
# ACCESS_KEY =
# SECRET_KEY =
# BUCKET =
# DOMAIN =
